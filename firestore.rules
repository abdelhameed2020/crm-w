rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Security Functions (RBAC)
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function getUserRole() {
      let data = getUserData();
      return data != null ? data.role : null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'abdelhameedyahya81@gmail.com' ||
        request.auth.token.role == 'admin' ||
        getUserRole() == 'admin'
      );
    }

    function isManager() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'manager' ||
        getUserRole() == 'manager'
      );
    }

    // ==========================================
    // Users Collection
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Self-creation is strictly restricted to 'employee' role; promotions to manager/admin require existing admin
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role == 'employee') ||
        isAdmin()
      );
      // Users can update their profile but cannot escalate their role or modify permissions
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Employees Collection (Workload & Team Directory)
    // ==========================================
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      // Allow admin full control; allow employees to create/update their own presence/heartbeat document
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == employeeId);
      allow update: if isManager() || (
        isAuthenticated() && (
          request.auth.uid == employeeId ||
          (resource.data != null && (
            resource.data.userId == request.auth.uid ||
            resource.data.email == request.auth.token.email
          ))
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Customers Collection
    // ==========================================
    match /customers/{customerId} {
      allow read, create: if isAuthenticated();
      allow update: if isManager() || (
        isAuthenticated() && (
          resource.data.assignedEmployeeId == request.auth.uid ||
          resource.data.assignedEmployeeId == null ||
          !('assignedEmployeeId' in resource.data)
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Conversations Collection
    // ==========================================
    match /conversations/{conversationId} {
      // Managers can read all; employees can read chats assigned to them or unassigned waiting queue
      allow read: if isManager() || (
        isAuthenticated() && (
          resource.data.assignedEmployeeId == request.auth.uid ||
          resource.data.assignedEmployeeId == null ||
          !('assignedEmployeeId' in resource.data)
        )
      );
      allow create: if isAuthenticated();
      // Employees can only update their own assigned chats or claim an unassigned chat
      allow update: if isManager() || (
        isAuthenticated() && (
          resource.data.assignedEmployeeId == request.auth.uid ||
          (
            (resource.data.assignedEmployeeId == null || !('assignedEmployeeId' in resource.data)) &&
            request.resource.data.assignedEmployeeId == request.auth.uid
          )
        )
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Messages Collection
    // ==========================================
    match /messages/{messageId} {
      allow read, create: if isAuthenticated();
      // Only managers can edit arbitrary fields; employees can only update delivery status
      allow update: if isManager() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'externalMessageId', 'readAt', 'deliveredAt'])
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Channels & Integration Credentials
    // ==========================================
    match /channels/{channelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /channel_secrets/{channelId} {
      allow read, write: if false; // Accessible only by Cloud Functions via Firebase Admin SDK
    }

    // WhatsApp Accounts: Strictly Admin-only for write/update/delete
    match /whatsappAccounts/{accountId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==========================================
    // Tags, Activities, Notes
    // ==========================================
    match /tags/{tagId} {
      allow read, write: if isAuthenticated();
    }

    match /activities/{activityId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    match /notes/{noteId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    // ==========================================
    // Sales Pipelines & Deals
    // ==========================================
    match /pipelines/{dealId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isManager();
    }

    match /pipelineStages/{stageId} {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // ==========================================
    // Settings & Organization Profile
    // ==========================================
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /cannedResponses/{responseId} {
      allow read, write: if isAuthenticated();
    }

    match /deals/{dealId} {
      allow read, create: if isAuthenticated();
      allow update: if isManager() || (
        isAuthenticated() && (
          resource.data.assignedEmployeeId == request.auth.uid ||
          resource.data.assignedEmployeeId == null
        )
      );
      allow delete: if isManager();
    }
  }
}
