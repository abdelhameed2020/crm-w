rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // Helper Security Functions (RBAC)
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function isManager() {
      return isAuthenticated() && (
        getUserRole() == 'manager' ||
        request.auth.token.role == 'manager' ||
        isAdmin()
      );
    }

    function isEmployee() {
      return isAuthenticated() && (
        getUserRole() == 'employee' ||
        isManager()
      );
    }

    function canAccessConversation(convId) {
      let conv = get(/databases/$(database)/documents/conversations/$(convId)).data;
      return isManager() || (
        isEmployee() && (
          conv.assignedEmployeeId == null ||
          conv.assignedEmployeeId == request.auth.uid
        )
      );
    }

    // ==========================================
    // Users Collection
    // ==========================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Self-creation is strictly restricted to 'employee' role; promotions to manager/admin require existing admin
      allow create: if isAuthenticated() && (
        (request.auth.uid == userId && request.resource.data.role == 'employee') ||
        isAdmin()
      );
      // Users can update their profile but cannot escalate their role or modify permissions
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions'])
      );
      allow delete: if isAdmin();
    }

    // ==========================================
    // Employees Collection (Workload & Team Directory)
    // ==========================================
    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      // Only Admin can add or remove employees; Managers can update operational fields (active chats, online status)
      allow create, delete: if isAdmin();
      allow update: if isManager();
    }

    // ==========================================
    // Customers Collection
    // ==========================================
    match /customers/{customerId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update: if isEmployee();
      allow delete: if isAdmin();
    }

    // ==========================================
    // Conversations Collection
    // ==========================================
    match /conversations/{conversationId} {
      // Admin/Manager can view all conversations.
      // Employee can view unassigned conversations or conversations assigned to them.
      allow read: if isManager() || (
        isEmployee() && (
          resource.data.assignedEmployeeId == null ||
          resource.data.assignedEmployeeId == request.auth.uid
        )
      );

      // Create conversation: Staff starting outbound conversation or Backend Functions
      allow create: if isEmployee();

      // Write / Update rules:
      // 1. Manager and Admin can update and reassign any conversation.
      // 2. Employee can claim an unassigned conversation by assigning it to themselves.
      // 3. Employee can update a conversation assigned to them, but cannot reassign it to another employee.
      allow update: if isManager() || (
        isEmployee() && (
          // Case A: Claiming an unassigned conversation
          (resource.data.assignedEmployeeId == null && request.resource.data.assignedEmployeeId == request.auth.uid) ||
          // Case B: Updating their own assigned conversation (cannot steal or reassign to another agent)
          (resource.data.assignedEmployeeId == request.auth.uid && (
            request.resource.data.assignedEmployeeId == request.auth.uid ||
            request.resource.data.assignedEmployeeId == null
          ))
        )
      );

      allow delete: if isAdmin();
    }

    // ==========================================
    // Messages Collection
    // ==========================================
    match /messages/{messageId} {
      // Employees can only read messages belonging to conversations they have access to
      allow read: if isManager() || (
        isEmployee() && canAccessConversation(resource.data.conversationId)
      );
      // Employees can send messages only into conversations they are authorized to access
      allow create: if isManager() || (
        isEmployee() && canAccessConversation(request.resource.data.conversationId)
      );
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // ==========================================
    // Channels & Integration Credentials
    // ==========================================
    match /channels/{channelId} {
      // General channel metadata (name, type, status) is readable by staff
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // Secret credentials (API tokens, webhooks secrets) are forbidden from client SDK access
    match /channel_secrets/{channelId} {
      allow read, write: if false; // Accessible only by Cloud Functions via Firebase Admin SDK
    }

    // ==========================================
    // Tags, Activities, Notes
    // ==========================================
    match /tags/{tagId} {
      allow read: if isEmployee();
      allow write: if isManager();
    }

    match /activities/{activityId} {
      allow read: if isEmployee();
      allow create: if isEmployee();
      allow update, delete: if isManager();
    }

    match /notes/{noteId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isManager() || (
        isEmployee() && resource.data.authorId == request.auth.uid
      );
    }

    // ==========================================
    // Sales Pipelines & Deals (Commercial & Revenue Protection)
    // ==========================================
    match /pipelines/{dealId} {
      // Admin/Manager can view all deals. Employee can only view deals assigned to them
      allow read: if isManager() || (
        isEmployee() && resource.data.assignedEmployeeId == request.auth.uid
      );
      allow create: if isEmployee();
      allow update: if isManager() || (
        isEmployee() && resource.data.assignedEmployeeId == request.auth.uid
      );
      allow delete: if isManager();
    }

    match /pipelineStages/{stageId} {
      allow read: if isEmployee();
      allow write: if isManager();
    }

    // ==========================================
    // Settings & Organization Profile
    // ==========================================
    match /settings/{settingId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }

    // ==========================================
    // WhatsApp Accounts (Multi-device Web & Cloud Lines)
    // ==========================================
    match /whatsappAccounts/{accountId} {
      allow read: if isEmployee();
      allow write: if isAdmin();
    }
  }
}
