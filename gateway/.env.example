# ==============================================================================
# WhatsApp Gateway - Production Environment Template (gateway/.env.example)
# ==============================================================================
# Copy this file to gateway/.env on your server or container.
# NEVER commit the actual gateway/.env with production credentials to Git.
# ==============================================================================

# Node Environment
NODE_ENV=production

# Server Port (default 5001)
GATEWAY_PORT=5001

# Gateway Internal Master Key (for server-to-server / CLI maintenance)
# Generate a strong 32+ character random secret for production
GATEWAY_API_KEY=generate_a_random_secure_secret_for_production_here

# Allowed Frontend Origins for CORS (comma-separated, without trailing slashes)
# Example: https://crm-awlad-yahya.web.app,https://crm-awlad-yahya.firebaseapp.com
ALLOWED_ORIGINS=https://crm-awlad-yahya.web.app,https://crm-awlad-yahya.firebaseapp.com

# Storage Paths (Must be mounted to persistent storage in Docker/VM)
SESSIONS_DIR=./sessions
UPLOADS_DIR=./uploads

# Firebase Configuration for Backend Token Verification & Firestore Admin
FIREBASE_PROJECT_ID=crm-awlad-yahya
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ==============================================================================
# Meta WhatsApp Cloud API (Official Business Account)
# ==============================================================================
# Meta App Secret (Used to verify x-hub-signature-256 HMAC of incoming webhooks)
META_APP_SECRET=your_meta_app_secret_here

# Meta Webhook Verify Token (Custom token you enter in Meta App Dashboard Webhook settings)
META_WEBHOOK_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta System User Access Token (Permanent token with whatsapp_business_messaging permissions)
META_CLOUD_API_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Meta Phone Number ID (from WhatsApp Business Platform Phone Numbers section)
META_CLOUD_API_PHONE_NUMBER_ID=your_phone_number_id_here

# Meta Graph API Version (defaults to v21.0)
META_GRAPH_API_VERSION=v21.0

# Meta WhatsApp Business Account ID (WABA ID)
META_WABA_ID=your_waba_id_here

