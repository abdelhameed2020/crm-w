# Firebase Configuration
# Replace these placeholder values with your actual Firebase project settings
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# App Environment
VITE_APP_NAME="CRM & Unified Inbox"
VITE_APP_DEFAULT_LANG=ar

# WhatsApp Provider Configuration (Phase 3: web | Phase 4: cloud)
VITE_WHATSAPP_PROVIDER=web
VITE_GATEWAY_URL=http://localhost:5001
VITE_GATEWAY_API_KEY=crm_gateway_secret_2026
