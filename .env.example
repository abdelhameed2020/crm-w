# ==============================================================================
# CRM Awlad Yahya - Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: Do NOT put real secrets in this file. Copy this file to .env for local
# development or configure these variables in your CI/CD / hosting dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Web App Configuration
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=crm-awlad-yahya.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crm-awlad-yahya
VITE_FIREBASE_STORAGE_BUCKET=crm-awlad-yahya.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# ------------------------------------------------------------------------------
# 2. General Application Settings
# ------------------------------------------------------------------------------
VITE_APP_NAME="OmniCRM - أولاد يحيى"
VITE_APP_DEFAULT_LANG=ar

# ------------------------------------------------------------------------------
# 3. WhatsApp Integration
# - VITE_WHATSAPP_PROVIDER: 'web' (Baileys Web Gateway) or 'cloud' (Meta Cloud API)
# - VITE_GATEWAY_URL: Public HTTPS URL of the hosted WhatsApp Gateway in production
#   (e.g., https://wa-gateway.example.com) or http://localhost:5001 in development.
# ------------------------------------------------------------------------------
VITE_WHATSAPP_PROVIDER=web
VITE_GATEWAY_URL=http://localhost:5001

# NOTE: For security, VITE_GATEWAY_API_KEY is intentionally left blank in production.
# The frontend authenticates requests dynamically using Firebase Auth Bearer tokens.
VITE_GATEWAY_API_KEY=
